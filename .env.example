# =========================================================
# SELLZON ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.
# Replace placeholder values with your own configuration.
# Never commit real credentials to Git.
# =========================================================

# ===== DATABASE: POSTGRESQL =====
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace-with-your-local-postgres-password

IDENTITY_DB_URL=jdbc:postgresql://host.docker.internal:5432/identity_db
CATALOG_DB_URL=jdbc:postgresql://host.docker.internal:5432/catalog_db
INVENTORY_DB_URL=jdbc:postgresql://host.docker.internal:5432/inventory_db
ORDER_DB_URL=jdbc:postgresql://host.docker.internal:5432/order_db
PAYMENT_DB_URL=jdbc:postgresql://host.docker.internal:5432/payment_db

# ===== INTERNAL SERVICES =====
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
CONFIG_SERVER_URL=http://config-server:8888
KAFKA_BOOTSTRAP_SERVERS=kafka:9093

# ===== EMAIL =====
MAIL_USERNAME=replace-with-your-email
MAIL_PASSWORD=replace-with-your-email-app-password

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# ===== CLOUDINARY =====
SELLZON_STORAGE_PROVIDER=cloudinary
SELLZON_STORAGE_CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
SELLZON_STORAGE_CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
SELLZON_STORAGE_CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret

# ===== INTERNAL SERVICE AUTHENTICATION =====
SELLZON_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

# ===== INVENTORY OAUTH CLIENT =====
INVENTORY_OAUTH_CLIENT_ID=inventory-service
INVENTORY_OAUTH_CLIENT_SECRET=replace-with-a-strong-random-secret

# ===== RAZORPAY TEST OR LIVE CREDENTIALS =====
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

# ===== JWT KEY DIRECTORY =====
# Windows local development example:
SELLZON_KEYS_DIR=D:/path/to/your/Sellzon-local-keys

# Linux VPS example:
# SELLZON_KEYS_DIR=/opt/sellzon/keys